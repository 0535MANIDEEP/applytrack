# Copy this file to .env and fill it in. Never commit .env.

# ---------------------------------------------------------------------------
# JWT_SECRET is required. The app refuses to start without it.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# If you change this, everyone who is signed in has to sign in again.
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# DATABASE_URL points at Postgres.
#
# Neon gives a free Postgres with no expiry and no credit card:
#   https://neon.tech  ->  Create project  ->  Copy connection string
#
# The format is:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# Render also provides Postgres, but the free tier databases there expire
# after 30 days, so Neon is the better free option.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Render sets this automatically. Locally it is just not set.
PORT=3001

# Set this in development only, to the front end's address, because the
# dev server runs on a different port than the API.
# CORS_ORIGIN=http://localhost:1234