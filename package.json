{
  "name": "applytrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Track job applications in one place",
  "main": "src/server.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "web": "npm run dev --workspace=web",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --import ./test/setup.js test/*.test.js",
    "build": "npm run build --workspace=web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1"
  }
}
